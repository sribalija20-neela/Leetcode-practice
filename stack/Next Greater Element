class Solution:
    def nextGreaterElement(self, nums1: List[int], nums2: List[int]) -> List[int]:
        backpack = []
        greater_map = {}
        
        for num in nums2:
            while backpack and backpack[-1] < num:
                smaller_num = backpack.pop()
                greater_map[smaller_num] = num
            backpack.append(num)
            
        ans = []
        for num in nums1:
            if num in greater_map:
                ans.append(greater_map[num])
            else:
                ans.append(-1)
                
        return ans
